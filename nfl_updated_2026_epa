# 5. TRAIN A GAME MARGIN MODEL
# ============================================================
#Predict score difference in individual matchup
def build_game_training_data(schedules, team_epa):
    games = schedules[
        (schedules['game_type'] == 'REG') &
        schedules['home_score'].notna() &
        schedules['away_score'].notna()
    ].copy()

    games['point_diff'] = (
        games['home_score'] - games['away_score']
    )

    epa = team_epa[
        [
            'season', 'team',
            'off_epa_per_game',
            'def_epa_allowed_per_game'
        ]
    ]

    # Home-team ratings, attach home team EPA and def EPA
    games = games.merge(
        epa,
        left_on=['season', 'home_team'],
        right_on=['season', 'team'],
        how='inner'
    )

    games = games.rename(columns={
        'off_epa_per_game': 'home_off_epa',
        'def_epa_allowed_per_game': 'home_def_epa'
    }).drop(columns='team')

    # Away-team ratings
    games = games.merge(
        epa,
        left_on=['season', 'away_team'],
        right_on=['season', 'team'],
        how='inner'
    )

    games = games.rename(columns={
        'off_epa_per_game': 'away_off_epa',
        'def_epa_allowed_per_game': 'away_def_epa'
    }).drop(columns='team')

    return games


games_train = build_game_training_data(
    schedules_train,
    team_epa_train
)
# Fit linear regression using home and away epa's
