# ============================================================
# 2. CALCULATE TEAM EPA PER GAME
# ============================================================
#filter through regular season only plays, plays with an EPA, plays with offensive and defensive team

def compute_team_epa_per_game(pbp):
    pbp_reg = pbp[
        (pbp['season_type'] == 'REG') &
        (pbp['epa'].notna()) &
        (pbp['posteam'].notna()) &
        (pbp['defteam'].notna())
    ].copy()

    # Offensive EPA by team and season
    #Sepearate data by season and offensive team, aggregate calculates offensive epa sum across all team plays, games played where team was on offense
    off = (
        pbp_reg.groupby(['season', 'posteam'])
        .agg(
            off_epa=('epa', 'sum'),
            games_played_off=('game_id', 'nunique')
        )
        .reset_index()
        .rename(columns={'posteam': 'team'})
    )

    # Defensive EPA allowed by team and season
    #calculates how much EPA teams gained against defensive team, lower epa better
    defense = (
        pbp_reg.groupby(['season', 'defteam'])
        .agg(
            def_epa_allowed=('epa', 'sum'),
            games_played_def=('game_id', 'nunique')
        )
        .reset_index()
        .rename(columns={'defteam': 'team'})
    )

    # Merge using both season and team
    team_epa = off.merge(
        defense,
        on=['season', 'team'],
        how='inner'
    )

    team_epa['off_epa_per_game'] = (
        team_epa['off_epa'] /
        team_epa['games_played_off']
    )

    team_epa['def_epa_allowed_per_game'] = (
        team_epa['def_epa_allowed'] /
        team_epa['games_played_def']
    )

    # Higher net EPA is better, offensive epa divided by defensive epa
    team_epa['net_epa_per_game'] = (
        team_epa['off_epa_per_game'] -
        team_epa['def_epa_allowed_per_game']
    )

    return team_epa


# ============================================================
# 3. CALCULATE WINS
# ============================================================
#for regular season games, forecasting 2026 games
def compute_season_wins(schedules):
    games = schedules[
        (schedules['game_type'] == 'REG') &
        schedules['home_score'].notna() &
        schedules['away_score'].notna()
    ].copy()

    # Home-team results, find the teams involved in the game and how many points scored
    home = games[
        ['season', 'home_team', 'home_score', 'away_score']
    ].copy()

    home.columns = [
        'season', 'team', 'points_for', 'points_against'
    ]

    # Away-team results
    away = games[
        ['season', 'away_team', 'away_score', 'home_score']
    ].copy()

    away.columns = [
        'season', 'team', 'points_for', 'points_against'
    ]
#stacks home and away records vertically Home team 24, points against 17
    results = pd.concat([home, away], ignore_index=True)

    # NFL ties count as half a win, assign win values, 1 for win
    results['win_value'] = np.select(
        [
            results['points_for'] > results['points_against'],
            results['points_for'] == results['points_against']
        ],
        [1.0, 0.5],
        default=0.0
    )
#sum wins by team and season
    return (
        results.groupby(['season', 'team'], as_index=False)
        .agg(wins=('win_value', 'sum'))
    )


