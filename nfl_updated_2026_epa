#retrieve two team ratings
def simulate_game(home_team, away_team, team_epa, model,
                  n_sims=N_GAME_SIMS):
    home_matches = team_epa[team_epa['team'] == home_team]
    away_matches = team_epa[team_epa['team'] == away_team]

    if home_matches.empty or away_matches.empty:
        raise ValueError(
            f"Missing EPA ratings for {home_team} or {away_team}"
        )

    home = home_matches.iloc[0]
    away = away_matches.iloc[0]
#creates one row containing the epa for each teams
    X = pd.DataFrame([{
        'home_off_epa': home['off_epa_per_game'],
        'home_def_epa': home['def_epa_allowed_per_game'],
        'away_off_epa': away['off_epa_per_game'],
        'away_def_epa': away['def_epa_allowed_per_game']
    }])

    # The historical point-differential model already learns
    # the average home-field effect from home-minus-away margins.
    # Do not add HFA a second time.
    expected_margin = float(model.predict(X)[0])
#sim possible margins, loc setes center of distribution, scale controls how spread out resuls are, size is number of simulated outocmes
    simulated_margins = rng.normal(
        loc=expected_margin,
        scale=sigma,
        size=n_sims
    )

    return {
        'expected_margin': expected_margin,
        'home_win_prob': np.mean(simulated_margins > 0),
        'away_win_prob': np.mean(simulated_margins < 0),
        'median_margin': np.median(simulated_margins),
        'p10_margin': np.percentile(simulated_margins, 10),
        'p90_margin': np.percentile(simulated_margins, 90)
    }


game_prob_rows = []
# apply function for all remaining games
