def get_playoff_teams(wins_row, team_info):
    df = pd.DataFrame({
        'team': wins_row.index,
        'wins': wins_row.values
    }).merge(team_info, on='team', how='inner')

    playoff_teams = []

    for conference in ['AFC', 'NFC']:
        conf_df = df[
            df['conference'] == conference
        ].copy()

        # Randomize exact win ties.
        # This is a simplified tie-breaker, not official NFL rules.
        conf_df['tie_break'] = rng.random(len(conf_df))

        conf_df = conf_df.sort_values(
            ['wins', 'tie_break'],
            ascending=[False, True]
        )

        # Four division winners
        division_winners = (
            conf_df.groupby('division', sort=False)
            .head(1)
        )

        playoff_teams.extend(
            division_winners['team'].tolist()
        )

        # Three best remaining teams as wild cards
        remaining = conf_df[
            ~conf_df['team'].isin(division_winners['team'])
        ]

        wild_cards = remaining.head(3)

        playoff_teams.extend(wild_cards['team'].tolist())

    return playoff_teams


def calculate_playoff_odds(season_sims, team_info):
    playoff_counts = pd.Series(
        0, index=season_sims.columns, dtype=float
    )

    for _, wins_row in season_sims.iterrows():
        playoff_teams = get_playoff_teams(
            wins_row, team_info
        )

        playoff_counts.loc[playoff_teams] += 1

    playoff_odds = playoff_counts / len(season_sims)

    return playoff_odds.sort_values(ascending=False)


