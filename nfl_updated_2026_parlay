def predict_qb_matchup(
    qb_name,
    team,
    opponent,
    is_home,
    data=qb_model_data
):
    """
    Predict a QB's statline for a future matchup.

    Example:
        predict_qb_matchup("B.Purdy", "SF", "SEA")
    """

    # Get this QB's most recent game in the data.
    # The rolling features on that row represent pregame information
    # available before that historical game.
    qb_rows = data[
        (data["qb_name"] == qb_name) &
        (data["team"] == team)
    ].sort_values(["season", "week", "game_id"])

    if qb_rows.empty:
        raise ValueError(
            f"No historical data found for {qb_name} on {team}."
        )

    latest = qb_rows.iloc[-1]

    # Use the QB's latest available pregame features as a starting point.
    # Replace the opponent defense features with the specified opponent's
    # most recent pregame defensive ratings.
    opponent_rows = team_games[
        (team_games["team"] == opponent) &
        (team_games["season"] == latest["season"]) &
        (team_games["week"] <= latest["week"])
    ].sort_values(["season", "week", "game_id"])

    if opponent_rows.empty:
        opponent_rows = team_games[
            team_games["team"] == opponent
        ].sort_values(["season", "week", "game_id"])

    if opponent_rows.empty:
        raise ValueError(f"No team data found for {opponent}.")

    opponent_latest = opponent_rows.iloc[-1]

    # Start with the QB's latest feature row.
    X = latest[feature_cols].to_frame().T.copy()
    X.loc[:, "is_home"] = int(is_home)
    # Update the opponent defense ratings.
    defense_map = {
        "opp_pregame_def_epa_allowed": "pregame_def_epa_allowed",
        "opp_pregame_def_success_allowed": "pregame_def_success_allowed",
        "opp_pregame_def_pass_epa_allowed": "pregame_def_pass_epa_allowed",
        "opp_pregame_def_rush_epa_allowed": "pregame_def_rush_epa_allowed",
        "opp_pregame_def_yards_per_play_allowed": "pregame_def_yards_per_play_allowed",
    }

    for model_col, team_col in defense_map.items():
        if model_col in X.columns and team_col in opponent_latest.index:
            X.loc[:, model_col] = opponent_latest[team_col]

    # Predict the five stats.
    result = {
        "QB": qb_name,
        "Team": team,
        "Opponent": opponent,
    }

    for target, model in final_models.items():
        result[target] = max(0, float(model.predict(X)[0]))

    return pd.DataFrame([result])

