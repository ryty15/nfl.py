def add_prediction_ranges(prediction_df, error_ranges):
    result = prediction_df.copy()

    for _, row in error_ranges.iterrows():
        stat = row["Stat"]

        if stat not in result.columns:
            continue

        # Historical error = actual - predicted
        result[f"{stat}_low"] = (
            result[stat] + row["10th_pct_error"]
        ).clip(lower=0)

        result[f"{stat}_high"] = (
            result[stat] + row["90th_pct_error"]
        ).clip(lower=0)

    return result


