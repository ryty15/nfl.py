# --------------------------------------------------
# 1. LOAD HISTORICAL PLAY-BY-PLAY DATA
# --------------------------------------------------

SEASONS = list(range(2024, 2027))


pbp = nfl.load_pbp(seasons=SEASONS).to_pandas()

# Keep only regular-season plays with valid teams.
pbp = pbp[
    (pbp["season_type"] == "REG") &
    pbp["posteam"].notna() &
    pbp["defteam"].notna()
].copy()

# Keep only the columns needed by the rest of the script.
needed_cols = [
    "season", "week", "game_id", "season_type",
    "posteam", "defteam", "home_team", "play_id",
    "play_type", "qb_kneel", "qb_spike", "play_deleted",
    "epa", "yards_gained", "success",
    "pass_attempt", "rush_attempt", "complete_pass",
    "pass_touchdown", "interception", "sack",
    "passing_yards", "rushing_yards", "rush_touchdown",
    "passer_player_id", "passer_player_name",
    "rusher_player_id"
]

pbp = pbp[needed_cols].copy()

pbp = pbp.sort_values(
    ["season", "week", "game_id"]
).reset_index(drop=True)

print("Rows:", len(pbp), flush=True)
print("Seasons:", sorted(pbp["season"].unique()), flush=True)
print("Columns retained:", len(pbp.columns), flush=True)




# --------------------------------------------------
# 2. CREATE TEAM-GAME STATISTICS
# --------------------------------------------------

# Use plays that can contribute to offensive performance.
plays = pbp[
    (pbp["play_type"].isin(["pass", "run"])) &
    (pbp["qb_kneel"] != 1) &
    (pbp["qb_spike"] != 1) &
    (pbp["play_deleted"] != 1)
].copy()

# Ensure numeric columns are usable.
for col in ["epa", "yards_gained", "success",
            "pass_attempt", "rush_attempt",
            "complete_pass", "pass_touchdown",
            "interception", "rushing_yards",
            "passing_yards", "rush_touchdown"]:
    plays[col] = pd.to_numeric(
        plays[col], errors="coerce"
    )

# Aggregate each offense's performance in each game.

# Create separate columns for pass and rush EPA
plays["pass_epa"] = plays["epa"].where(
    plays["play_type"] == "pass"
)
plays["rush_epa"] = plays["epa"].where(
    plays["play_type"] == "run"
)

# Aggregate each offense's performance in each game
team_offense = (
    plays.groupby(
        ["season", "week", "game_id", "posteam", "defteam"],
        as_index=False
    )
    .agg(
        offensive_epa=("epa", "mean"),
        offensive_success=("success", "mean"),
        offensive_yards_per_play=("yards_gained", "mean"),
        offensive_pass_epa=("pass_epa", "mean"),
        offensive_rush_epa=("rush_epa", "mean"),
        plays=("play_id", "count")
    )
    .rename(columns={
        "posteam": "team",
        "defteam": "opponent"
    })
)

#print(team_offense.head())



# --------------------------------------------------
# 3. CREATE QUARTERBACK GAME STATS
# --------------------------------------------------

qb_plays = plays[
    plays["passer_player_id"].notna()
].copy()

# A quarterback can have multiple play rows per game.
qb_passing = (
    qb_plays.groupby(
        ["season", "week", "game_id",
         "posteam", "defteam",
         "passer_player_id", "passer_player_name"],
        as_index=False
    )
    .agg(
        attempts=("pass_attempt", "sum"),
        completions=("complete_pass", "sum"),
        passing_yards=("passing_yards", "sum"),
        passing_tds=("pass_touchdown", "sum"),
        interceptions=("interception", "sum"),
        sacks=("sack", "sum"),
        passing_epa=("epa", "mean")
    )
)

# Rushing production for quarterbacks.
# Scrambles are associated with the QB in rusher_player_id.
qb_rush_plays = plays[
    plays["rusher_player_id"].notna()
].copy()

qb_rushing = (
    qb_rush_plays.groupby(
        ["season", "week", "game_id",
         "posteam", "rusher_player_id"],
        as_index=False
    )
    .agg(
        rushing_attempts=("rush_attempt", "sum"),
        rushing_yards=("rushing_yards", "sum"),
        rushing_tds=("rush_touchdown", "sum")
    )
    .rename(columns={
        "rusher_player_id": "passer_player_id"
    })
)

qb_games = qb_passing.merge(
    qb_rushing,
    on=["season", "week", "game_id",
        "posteam", "passer_player_id"],
    how="left"
)

for col in [
    "rushing_attempts", "rushing_yards", "rushing_tds"
]:
    qb_games[col] = qb_games[col].fillna(0)

qb_games = qb_games.rename(columns={
    "posteam": "team",
    "defteam": "opponent",
    "passer_player_id": "qb_id",
    "passer_player_name": "qb_name"
})

print(qb_games.head())
