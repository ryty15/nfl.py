# 4. BUILD PREGAME TEAM RATINGS
# --------------------------------------------------

# One row per team per game.
team_games = team_offense.copy()

# Match each team's game with the opponent's offensive
# performance in that same game. That performance tells
# us how the opponent's offense performed against this team.
opponent_stats = team_offense[
    [
        "game_id",
        "team",
        "opponent",
        "offensive_epa",
        "offensive_success",
        "offensive_pass_epa",
        "offensive_rush_epa",
        "offensive_yards_per_play"
    ]
].copy()

opponent_stats = opponent_stats.rename(columns={
    "team": "opponent",
    "opponent": "team",
    "offensive_epa": "def_epa_allowed",
    "offensive_success": "def_success_allowed",
    "offensive_pass_epa": "def_pass_epa_allowed",
    "offensive_rush_epa": "def_rush_epa_allowed",
    "offensive_yards_per_play": "def_yards_per_play_allowed"
})

team_games = team_games.merge(
    opponent_stats,
    on=["game_id", "team", "opponent"],
    how="left",
    validate="one_to_one"
)


# Identify the venue for each team's game
game_locations = (
    pbp[["game_id", "home_team"]]
    .drop_duplicates(subset=["game_id"])
)

team_games = team_games.merge(
    game_locations,
    on="game_id",
    how="left",
    validate="many_to_one"
)

team_games["is_home"] = (
    team_games["team"] == team_games["home_team"]
).astype(int)


# Features used to find similar teams and matchups.
feature_cols = [
    "offensive_epa",
    "offensive_success",
    "offensive_pass_epa",
    "offensive_rush_epa",
    "offensive_yards_per_play",
    "def_epa_allowed",
    "def_success_allowed",
    "def_pass_epa_allowed",
    "def_rush_epa_allowed",
    "def_yards_per_play_allowed"
]

# Sort chronologically.
team_games = team_games.sort_values(
    ["season", "week", "game_id", "team"]
).reset_index(drop=True)

# Calculate rolling ratings using previous games only.
# Calculate each team's average from its previous 4 games
# within the same season. The current game is excluded.
for col in feature_cols:
    team_games[f"pregame_{col}"] = (
        team_games
        .groupby(["season", "team"])[col]
        .transform(
            lambda s: s.shift(1).rolling(
                window=4,
                min_periods=1
            ).mean()
        )
    )

# Venue-specific offensive and defensive statistics
venue_stats = [
    "offensive_epa",
    "offensive_pass_epa",
    "offensive_rush_epa",
    "def_epa_allowed",
    "def_pass_epa_allowed",
    "def_rush_epa_allowed"
]

# Average each team's previous four games at the same venue.
# shift(1) prevents the current game's results from leaking
# into its pregame features.
# Use previous games at the same venue across seasons
for col in venue_stats:
    team_games[f"pregame_home_away_{col}"] = (
        team_games
        .groupby(["team", "is_home"])[col]
        .transform(
            lambda s: s.shift(1).rolling(
                window=4,
                min_periods=1
            ).mean()
        )
    )

print("\nVenue-specific EPA ratings:")
print(
    team_games[
        ["season", "week", "team", "opponent", "is_home",
         "pregame_home_away_offensive_epa",
         "pregame_home_away_def_epa_allowed"]
    ].tail(10).to_string(index=False)
)


print("\nPregame team ratings:")
