]




# Stats we want to predict
target_cols = [
    "passing_yards",
    "passing_tds",
    "interceptions",
    "rushing_yards",
    "rushing_tds"
]

# Remove rows missing any required feature or target
model_data = qb_model_data.dropna(
    subset=feature_cols + target_cols
).copy()

print("Usable QB-game rows:", len(model_data))
print("Seasons available:", sorted(model_data["season"].unique()))
print(model_data.groupby("season").size())


# ==========================================
# 1. SPLIT DATA INTO TRAINING AND TESTING
# ==========================================

train = model_data[model_data["season"] <= 2024].copy()
test = model_data[model_data["season"] == 2025].copy()

X_train = train[feature_cols]
X_test = test[feature_cols]

print("Training rows:", len(train))
print("Testing rows:", len(test))


# ==========================================
# 2. LINEAR REGRESSION EVALUATION
# ==========================================

predictions = test[
    ["season", "week", "game_id", "qb_id",
     "qb_name", "team", "opponent"]
].copy()

linear_models = {}
linear_results = []

for target in target_cols:
    model = LinearRegression()

    # Train the model
    model.fit(X_train, train[target])

    # Predict the 2025 test games
    y_pred = model.predict(X_test)

    # Save model and predictions
    linear_models[target] = model
    predictions[f"actual_{target}"] = test[target].to_numpy()
    predictions[f"predicted_{target}"] = y_pred

    # Calculate mean absolute error
    mae = np.mean(np.abs(test[target].to_numpy() - y_pred))

    linear_results.append({
        "Stat": target,
        "LinearRegression_MAE": mae
    })

print("\n" + "=" * 75)
print("LINEAR REGRESSION RESULTS")
print("=" * 75)
print(pd.DataFrame(linear_results).round(3).to_string(index=False))


# ==========================================
# 3. TREE-BASED MODEL
# HIST GRADIENT BOOSTING
# ==========================================

tree_models = {}
tree_results = []

for target in target_cols:
    tree_model = HistGradientBoostingRegressor(
        max_iter=200,
        learning_rate=0.05,
        max_leaf_nodes=15,
        l2_regularization=1.0,
        random_state=42
    )

    # Train on the same data
    tree_model.fit(X_train, train[target])

    # Predict the same 2025 test games
    tree_pred = tree_model.predict(X_test)

    tree_models[target] = tree_model

    # Compare both models on the same rows
    actual = test[target].to_numpy()
    linear_pred = predictions[f"predicted_{target}"].to_numpy()

    linear_mae = np.mean(np.abs(actual - linear_pred))
    tree_mae = np.mean(np.abs(actual - tree_pred))

    improvement = linear_mae - tree_mae
    improvement_pct = (
        improvement / linear_mae * 100
        if linear_mae != 0 else 0
    )

    tree_results.append({
        "Stat": target,
        "Linear_MAE": linear_mae,
        "Tree_MAE": tree_mae,
        "MAE_Improvement": improvement,
        "Improvement_Percent": improvement_pct
    })

tree_results_df = pd.DataFrame(tree_results)

print("\n" + "=" * 85)
print("LINEAR REGRESSION VS TREE-BASED MODEL")
print("=" * 85)
print(tree_results_df.round(3).to_string(index=False))


# ==========================================
# 4. RECENT FOUR-GAME BASELINE
# ==========================================

baseline_history = qb_history[
    ["season", "week", "game_id", "qb_id"] + target_cols
].copy()

baseline_history = baseline_history.sort_values(
    ["season", "week", "game_id", "qb_id"]
).reset_index(drop=True)

baseline_cols = []

# Use only previous qualifying games for each quarterback
for target in target_cols:
    baseline_col = f"baseline_{target}"
    baseline_cols.append(baseline_col)

    baseline_history[baseline_col] = (
        baseline_history.groupby("qb_id")[target]
        .transform(
            lambda s: s.shift(1).rolling(
                window=4, min_periods=1
            ).mean()
        )
    )

join_cols = ["season", "week", "game_id", "qb_id"]

baseline_predictions = test[join_cols].merge(
    baseline_history[join_cols + baseline_cols],
    on=join_cols,
    how="left",
    validate="one_to_one"
)

# For QBs without previous qualifying games, use
# the training-set mean for that statistic.
for target, baseline_col in zip(target_cols, baseline_cols):
    baseline_predictions[baseline_col] = (
        baseline_predictions[baseline_col]
        .fillna(train[target].mean())
    )


# ==========================================
# 5. COMPARE ALL THREE METHODS
# ==========================================

comparison_results = []

for target, baseline_col in zip(target_cols, baseline_cols):
    actual = test[target].to_numpy()

    linear_pred = predictions[
        f"predicted_{target}"
    ].to_numpy()

    # Recreate tree predictions for this target
    tree_pred = tree_models[target].predict(X_test)

    baseline_pred = baseline_predictions[
        baseline_col
    ].to_numpy()

    linear_mae = np.mean(np.abs(actual - linear_pred))
    tree_mae = np.mean(np.abs(actual - tree_pred))
    baseline_mae = np.mean(np.abs(actual - baseline_pred))

    comparison_results.append({
        "Stat": target,
        "Recent4_MAE": baseline_mae,
        "Linear_MAE": linear_mae,
        "Tree_MAE": tree_mae,
        "Best_Model": min(
            [
