from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, root_mean_squared_error

# Features available before kickoff

feature_cols = [
    "qb_recent_attempts",
    "qb_recent_completions",
    "qb_recent_passing_yards",
