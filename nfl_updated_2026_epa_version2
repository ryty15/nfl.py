#Predict score difference in individual matchup
def build_game_training_data(schedules, team_game_stats):
    # Keep completed regular-season games
    games = schedules[
        (schedules["game_type"] == "REG") &
        schedules["home_score"].notna() &
        schedules["away_score"].notna()
    ].copy()

    games["point_diff"] = (
        games["home_score"] - games["away_score"]
    )

    # Get each team's game-by-game statistics
    stats = compute_pregame_team_stats(team_game_stats)

    # Features available BEFORE each game
    pregame_features = [
        "pregame_pass_epa",
        "pregame_pass_success",
        "pregame_rush_epa",
        "pregame_rush_success",
        "pregame_def_pass_epa",
        "pregame_def_pass_success",
        "pregame_def_rush_epa",
        "pregame_def_rush_success"
    ]

    # Keep only the identifiers and pregame statistics
    stats = stats[
        ["season", "week", "game_id", "team"] +
        pregame_features
    ].copy()

    # Attach pregame statistics for the home team
    games = games.merge(
        stats,
        left_on=["season", "week", "game_id", "home_team"],
        right_on=["season", "week", "game_id", "team"],
        how="inner"
    )

    games = games.rename(columns={
        col: "home_" + col.replace("pregame_", "")
        for col in pregame_features
    }).drop(columns="team")

    # Attach pregame statistics for the away team
    games = games.merge(
        stats,
        left_on=["season", "week", "game_id", "away_team"],
        right_on=["season", "week", "game_id", "team"],
        how="inner"
    )

    games = games.rename(columns={
        col: "away_" + col.replace("pregame_", "")
        for col in pregame_features
    }).drop(columns="team")

    # Remove games without sufficient prior statistics
   # Remove games missing ANY of the 16 model features
    games = games.dropna(
        subset=[
            "home_pass_epa",
            "home_pass_success",
            "home_rush_epa",
            "home_rush_success",
            "home_def_pass_epa",
            "home_def_pass_success",
            "home_def_rush_epa",
            "home_def_rush_success",
            "away_pass_epa",
            "away_pass_success",
            "away_rush_epa",
            "away_rush_success",
            "away_def_pass_epa",
            "away_def_pass_success",
             "away_def_rush_epa",
            "away_def_rush_success"
        ]
    )

    return games




