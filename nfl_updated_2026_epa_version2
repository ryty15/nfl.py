#sim 20,000 possible seasons, start with current wins
def simulate_seasons(game_probs, wins_so_far, n_sims=N_SEASON_SIMS):
    teams = wins_so_far['team'].tolist()

    # Each row represents one possible final season
    win_matrix = pd.DataFrame(
        np.tile(
            wins_so_far['wins_so_far'].to_numpy(),
            (n_sims, 1)
        ),
        columns=teams
    )
# simulate every remaining game, 1= win
    for _, game in game_probs.iterrows():
        home = game['home_team']
        away = game['away_team']
        p_home = game['home_win_prob']

        # Simulate this game once per simulated season
        home_wins = rng.binomial(1, p_home, size=n_sims)

        win_matrix[home] += home_wins
        win_matrix[away] += 1 - home_wins

    return win_matrix


season_sims = simulate_seasons(
    game_probs,
    wins_so_far,
    n_sims=N_SEASON_SIMS
)
# calculate average final wins
