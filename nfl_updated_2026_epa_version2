#retrieve two team ratings

def simulate_game(home_team, away_team, team_features, model,
                 n_sims=N_GAME_SIMS):

    home_matches = team_features[
        team_features["team"] == home_team
    ]
    away_matches = team_features[
        team_features["team"] == away_team
    ]

    if home_matches.empty or away_matches.empty:
        raise ValueError(
            f"Missing pregame stats for {home_team} or {away_team}"
        )

    home = home_matches.iloc[0]
    away = away_matches.iloc[0]

    # Use the same 16 features used to train the model
    X = pd.DataFrame([{
        "home_pass_epa": home["current_pass_epa"],
        "home_pass_success": home["current_pass_success"],
        "home_rush_epa": home["current_rush_epa"],
        "home_rush_success": home["current_rush_success"],
        "home_def_pass_epa": home["current_def_pass_epa"],
        "home_def_pass_success": home["current_def_pass_success"],
        "home_def_rush_epa": home["current_def_rush_epa"],
        "home_def_rush_success": home["current_def_rush_success"],
        "away_pass_epa": away["current_pass_epa"],
        "away_pass_success": away["current_pass_success"],
        "away_rush_epa": away["current_rush_epa"],
        "away_rush_success": away["current_rush_success"],
        "away_def_pass_epa": away["current_def_pass_epa"],
        "away_def_pass_success": away["current_def_pass_success"],
        "away_def_rush_epa": away["current_def_rush_epa"],
        "away_def_rush_success": away["current_def_rush_success"]
    }])

    # Match the feature order used during training
    X = X[GAME_FEATURES]

    expected_margin = float(model.predict(X)[0])

    simulated_margins = rng.normal(
        loc=expected_margin,
        scale=sigma,
        size=n_sims
    )

   
    return {
        "expected_margin": expected_margin,
        "home_win_prob": np.mean(simulated_margins > 0),
        "away_win_prob": np.mean(simulated_margins < 0),
        "median_margin": np.median(simulated_margins),
        "p10_margin": np.percentile(simulated_margins, 10),
        "p90_margin": np.percentile(simulated_margins, 90),
        "simulated_margins": simulated_margins
    }


#setup helper function 

def compute_latest_team_features(team_game_stats):
    stat_cols = [
        "pass_epa",
        "pass_success",
        "rush_epa",
        "rush_success",
        "def_pass_epa",
        "def_pass_success",
        "def_rush_epa",
        "def_rush_success"
    ]

    stats = team_game_stats.copy()

    stats = stats.sort_values(
        ["team", "season", "week", "game_id"]
    ).reset_index(drop=True)

    # Calculate cumulative averages through each completed game
    for col in stat_cols:
        stats[f"current_{col}"] = (
            stats.groupby("team")[col]
            .transform(lambda s: s.expanding().mean())
        )

    # Keep each team's latest completed-game averages
    latest = (
        stats.sort_values(["season", "week", "game_id"])
        .groupby("team", as_index=False)
        .tail(1)
        .reset_index(drop=True)
    )

    return latest

