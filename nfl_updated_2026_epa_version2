# 2. CALCULATE TEAM EPA PER GAME
# ============================================================
#filter through regular season only plays, plays with an EPA, plays with offensive and defensive team

def compute_team_epa_per_game(pbp):
    pbp_reg = pbp[
        (pbp['season_type'] == 'REG') &
        (pbp['epa'].notna()) &
        (pbp['posteam'].notna()) &
        (pbp['defteam'].notna())
    ].copy()

    # Offensive EPA by team and season
    #Sepearate data by season and offensive team, aggregate calculates offensive epa sum across all team plays, games played where team was on offense
    off = (
        pbp_reg.groupby(['season', 'posteam'])
        .agg(
            off_epa=('epa', 'sum'),
            games_played_off=('game_id', 'nunique')
        )
        .reset_index()
        .rename(columns={'posteam': 'team'})
    )

    # Defensive EPA allowed by team and season
    #calculates how much EPA teams gained against defensive team, lower epa better
    defense = (
        pbp_reg.groupby(['season', 'defteam'])
        .agg(
            def_epa_allowed=('epa', 'sum'),
            games_played_def=('game_id', 'nunique')
        )
        .reset_index()
        .rename(columns={'defteam': 'team'})
    )

    # Merge using both season and team
    team_epa = off.merge(
        defense,
        on=['season', 'team'],
        how='inner'
    )

    team_epa['off_epa_per_game'] = (
        team_epa['off_epa'] /
        team_epa['games_played_off']
    )

    team_epa['def_epa_allowed_per_game'] = (
        team_epa['def_epa_allowed'] /
        team_epa['games_played_def']
    )

    # Higher net EPA is better, offensive epa divided by defensive epa
    team_epa['net_epa_per_game'] = (
        team_epa['off_epa_per_game'] -
        team_epa['def_epa_allowed_per_game']
    )

    return team_epa

# ============================================================
# 2b. Calc Passing/Rushing EPA and success rate
# ============================================================
def compute_team_game_stats(pbp):
    #keep regular season plays with info needed
    plays= pbp[
        (pbp["season_type"]== "REG") &
        (pbp["epa"].notna()) &
        (pbp["posteam"].notna()) &
        (pbp["defteam"].notna()) &
        (pbp["play_type"].isin(["pass", "run"]))
    ].copy()
  # Create a success indicator if the data has no success column
    if "success" not in plays.columns:
        plays["success"] = (plays["epa"] > 0).astype(float)

    # Convert success to numeric and exclude missing values
    # Convert success to numeric
    plays["success"] = pd.to_numeric(
        plays["success"], errors="coerce"
)

# If success is missing, use positive EPA as a fallback
    plays["success"] = plays["success"].fillna(
         (plays["epa"] > 0).astype(float)
)

    # Passing plays by the offense
    pass_plays = plays[plays["play_type"] == "pass"]

    offense_pass = (
        pass_plays.groupby(
            ["season", "week", "game_id", "posteam"]
        )
        .agg(
            pass_epa=("epa", "mean"),
            pass_success=("success", "mean"),
            pass_plays=("epa", "size")
        )
        .reset_index()
        .rename(columns={"posteam": "team"})
    )

    # Rushing plays by the offense
    rush_plays = plays[plays["play_type"] == "run"]

    offense_rush = (
        rush_plays.groupby(
            ["season", "week", "game_id", "posteam"]
        )
        .agg(
            rush_epa=("epa", "mean"),
            rush_success=("success", "mean"),
            rush_plays=("epa", "size")
        )
        .reset_index()
        .rename(columns={"posteam": "team"})
    )

    # Defensive passing performance: EPA and success allowed
    defense_pass = (
        pass_plays.groupby(
            ["season", "week", "game_id", "defteam"]
        )
        .agg(
            def_pass_epa=("epa", "mean"),
            def_pass_success=("success", "mean")
        )
        .reset_index()
        .rename(columns={"defteam": "team"})
    )

    # Defensive rushing performance: EPA and success allowed
    defense_rush = (
        rush_plays.groupby(
            ["season", "week", "game_id", "defteam"]
        )
        .agg(
            def_rush_epa=("epa", "mean"),
            def_rush_success=("success", "mean")
        )
        .reset_index()
        .rename(columns={"defteam": "team"})
    )

    # Combine offensive and defensive statistics
    team_game_stats = offense_pass.merge(
        offense_rush,
        on=["season", "week", "game_id", "team"],
        how="outer"
    )

    team_game_stats = team_game_stats.merge(
        defense_pass,
        on=["season", "week", "game_id", "team"],
        how="outer"
    )

    team_game_stats = team_game_stats.merge(
        defense_rush,
        on=["season", "week", "game_id", "team"],
        how="outer"
    )

    return team_game_stats
def compute_pregame_team_stats(team_game_stats):
    # Statistics measured during each game
    stat_cols = [
        "pass_epa",
        "pass_success",
        "rush_epa",
        "rush_success",
        "def_pass_epa",
        "def_pass_success",
        "def_rush_epa",
        "def_rush_success"
    ]

    stats = team_game_stats.copy()

    # Put each team's games in chronological order
    stats = stats.sort_values(
        ["team", "season", "week", "game_id"]
    ).reset_index(drop=True)

    # Calculate averages using previous games only.
    # shift(1) prevents the current game's stats from leaking
    # into that game's pregame prediction.
    for col in stat_cols:
        stats[f"pregame_{col}"] = (
            stats.groupby("team")[col]
            .transform(
                lambda s: s.shift(1).expanding().mean()
            )
        )

    return stats

